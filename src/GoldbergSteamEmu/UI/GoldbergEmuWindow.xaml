<Window x:Class="GoldbergSteamEmu.UI.GoldbergEmuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GSE Manager" Height="640" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#EEEEEE">
    <Window.Resources>
        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#66BB6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RestoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#EF5350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding StateText, FallbackValue='Estado: a iniciar...'}"
                           FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding StateDetail, FallbackValue=''}"
                           FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AppIdDisplay}" Margin="0,8,0,0" Foreground="#CCCCCC"/>
                <CheckBox Content="Usar conta anónima" IsChecked="{Binding UseAnon}"
                          Margin="0,8,0,0" Foreground="#EEEEEE"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="#252526" Foreground="#EEEEEE" BorderBrush="#3F3F46">
            <TabItem Header="DLLs" Foreground="#EEEEEE">
                <ListBox ItemsSource="{Binding Dlls}" Background="#1E1E1E" Foreground="#EEEEEE"
                         BorderBrush="#3F3F46" Margin="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding Selected}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Path}" Foreground="#EEEEEE"/>
                                <TextBlock Text="{Binding Arch, StringFormat=' [{0}]'}" Foreground="#888888"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Conta" Foreground="#EEEEEE">
                <StackPanel Margin="14">
                    <TextBlock Text="Username:" Margin="0,0,0,4" Foreground="#EEEEEE"/>
                    <TextBox Text="{Binding Username}" Margin="0,0,0,10" Padding="4"
                             Background="#2D2D30" Foreground="#EEEEEE" BorderBrush="#3F3F46"/>
                    <TextBlock Text="Password:" Margin="0,0,0,4" Foreground="#EEEEEE"/>
                    <PasswordBox x:Name="PwdBox" Margin="0,0,0,10" Padding="4"
                                 Background="#2D2D30" Foreground="#EEEEEE" BorderBrush="#3F3F46"/>
                    <TextBlock Text="(Só usadas se a conta anónima estiver desativada.)"
                               FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Avançado" Foreground="#EEEEEE">
                <StackPanel Margin="14">
                    <CheckBox Content="Implantar Achievement Watcher" IsChecked="{Binding AcwEnabled}"
                              Foreground="#EEEEEE"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aplicar Goldberg" Command="{Binding ApplyCommand}"
                    Style="{StaticResource ApplyButtonStyle}" Width="170" Margin="0,0,10,0"/>
            <Button Content="Restaurar Original" Command="{Binding RestoreCommand}"
                    Style="{StaticResource RestoreButtonStyle}" Width="170"/>
        </StackPanel>
    </Grid>
</Window>
