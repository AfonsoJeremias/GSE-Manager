<Window x:Class="GoldbergSteamEmu.UI.GoldbergEmuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GSE Manager" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="White" Foreground="Black">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1"
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding StateText, FallbackValue='(a iniciar...)'}"
                           FontSize="14" FontWeight="Bold" Foreground="Black"/>
                <TextBlock Text="{Binding AppId, StringFormat='AppID: {0}', FallbackValue='AppID: (não detetado)'}"
                           Margin="0,5,0,0" Foreground="Black"/>
                <CheckBox Content="Usar conta anónima" IsChecked="{Binding UseAnon}"
                          Margin="0,5,0,0" Foreground="Black"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="White" Foreground="Black">
            <TabItem Header="DLLs" Foreground="Black">
                <ListBox ItemsSource="{Binding Dlls}" Background="White" Foreground="Black">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Selected}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Path}" Foreground="Black"/>
                                <TextBlock Text="{Binding Arch, StringFormat=' [{0}]'}" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Conta" Foreground="Black">
                <StackPanel Margin="10">
                    <TextBlock Text="Username:" Margin="0,0,0,4" Foreground="Black"/>
                    <TextBox Text="{Binding Username}" Margin="0,0,0,8"/>
                    <TextBlock Text="Password:" Margin="0,0,0,4" Foreground="Black"/>
                    <PasswordBox x:Name="PwdBox" Margin="0,0,0,8"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Avançado" Foreground="Black">
                <StackPanel Margin="10">
                    <CheckBox Content="Implantar Achievement Watcher" IsChecked="{Binding AcwEnabled}"
                              Foreground="Black"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Aplicar Goldberg" Command="{Binding ApplyCommand}" Width="140" Margin="0,0,8,0" Padding="4"/>
            <Button Content="Restaurar Original" Command="{Binding RestoreCommand}" Width="140" Padding="4"/>
        </StackPanel>
    </Grid>
</Window>
